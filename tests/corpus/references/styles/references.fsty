// References into nested enumerations (#325): an item takes its enum's
// pattern, and a reference to it shows the number as the item does.
page { page-size: A5; margin-top: 18mm; margin-bottom: 18mm; margin-inner: 16mm; margin-outer: 16mm; }
doc { font: "Source Serif 4"; font-size: 10.5pt; }
heading { font: "Source Sans 3"; font-size: 13pt; space-after: 6pt; numbering: "1"; }
enum { numbering: "(a)"; }
enum enum { numbering: "(i)"; }
enum-item { space-before: 4pt; }
