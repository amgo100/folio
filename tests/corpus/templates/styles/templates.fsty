page { page-size: A5; margin-top: 15mm; margin-bottom: 15mm; margin-inner: 15mm; margin-outer: 15mm; }
doc { font: "Source Serif 4"; font-size: 10pt; justify: true; hyphenate: true; }
heading { font-size: 13pt; space-before: 8pt; space-after: 5pt; keep-with-next: true; }
paragraph { space-after: 3pt; }

$accent: #1f5fa8;
$accent-tint: #e8eef7;

// The templates of SPEC §5.3.
example {
  padding: 3mm 4mm; border-left: 1.5pt solid $accent; background: $accent-tint;
  space-before: 8pt; space-after: 8pt; breakable: true;
  export-name: "Example";
}
example badge { color: $accent; border: 0.5pt solid $accent; }

render example {
  header: row(
    strong(term() " " counter() if field(title) { ": " field(title) }),
    align-end(badge(field(difficulty))) if field(difficulty) == "extension",
  );
  body: slot(statement) rule(0.4pt) slot(solution);
}

render example as compact { body: slot(statement); }
example.short { template: compact; }

// A grid: the formula's name beside it.
formula { space-before: 4pt; space-after: 4pt; }
render formula {
  body: grid(emph(field(name)), slot(), columns: 40mm 1fr);
}
formula grid { space-before: 0pt; space-after: 0pt; border-top: none; border-bottom: none; }
formula cell { justify: false; hyphenate: false; }

// An inline element's template sets its text in the line.
render keyword { body: strong(slot()); }
