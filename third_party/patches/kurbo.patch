diff -ruN a/src/common.rs b/src/common.rs
--- a/src/common.rs	2006-07-24 01:21:28.000000000 +0000
+++ b/src/common.rs	2026-11-27 06:06:15.265504294 +0000
@@ -17,6 +17,100 @@
 
 use arrayvec::ArrayVec;
 
+/// Folio: the float functions kurbo uses whose results the platform's maths
+/// library decides when they come from std, computed with the `libm` crate
+/// instead, so that the same input gives the same bits on every platform
+/// (Folio's SPEC §2.4). kurbo's code calls these `lm_` methods in place of
+/// the std methods of the same names. `lm_powi` multiplies by squaring, as
+/// the compiler's own `powi` routine does, rather than leave the result to
+/// the language.
+pub(crate) trait LibmFloat: Sized {
+    fn lm_acos(self) -> Self;
+    fn lm_atan2(self, other: Self) -> Self;
+    fn lm_cbrt(self) -> Self;
+    fn lm_cos(self) -> Self;
+    fn lm_hypot(self, other: Self) -> Self;
+    fn lm_ln(self) -> Self;
+    fn lm_log2(self) -> Self;
+    fn lm_powf(self, n: Self) -> Self;
+    fn lm_powi(self, n: i32) -> Self;
+    fn lm_sin(self) -> Self;
+    fn lm_sin_cos(self) -> (Self, Self);
+    fn lm_tan(self) -> Self;
+}
+
+macro_rules! impl_libm_float {
+    ($t:ty, $acos:ident, $atan2:ident, $cbrt:ident, $cos:ident, $hypot:ident, $ln:ident,
+     $log2:ident, $pow:ident, $sin:ident, $sincos:ident, $tan:ident) => {
+        impl LibmFloat for $t {
+            #[inline]
+            fn lm_acos(self) -> Self {
+                libm::$acos(self)
+            }
+            #[inline]
+            fn lm_atan2(self, other: Self) -> Self {
+                libm::$atan2(self, other)
+            }
+            #[inline]
+            fn lm_cbrt(self) -> Self {
+                libm::$cbrt(self)
+            }
+            #[inline]
+            fn lm_cos(self) -> Self {
+                libm::$cos(self)
+            }
+            #[inline]
+            fn lm_hypot(self, other: Self) -> Self {
+                libm::$hypot(self, other)
+            }
+            #[inline]
+            fn lm_ln(self) -> Self {
+                libm::$ln(self)
+            }
+            #[inline]
+            fn lm_log2(self) -> Self {
+                libm::$log2(self)
+            }
+            #[inline]
+            fn lm_powf(self, n: Self) -> Self {
+                libm::$pow(self, n)
+            }
+            #[inline]
+            fn lm_powi(self, n: i32) -> Self {
+                let mut base = self;
+                let mut exp = n.unsigned_abs();
+                let mut result = 1.0;
+                loop {
+                    if exp & 1 != 0 {
+                        result *= base;
+                    }
+                    exp >>= 1;
+                    if exp == 0 {
+                        break;
+                    }
+                    base *= base;
+                }
+                if n < 0 { 1.0 / result } else { result }
+            }
+            #[inline]
+            fn lm_sin(self) -> Self {
+                libm::$sin(self)
+            }
+            #[inline]
+            fn lm_sin_cos(self) -> (Self, Self) {
+                libm::$sincos(self)
+            }
+            #[inline]
+            fn lm_tan(self) -> Self {
+                libm::$tan(self)
+            }
+        }
+    };
+}
+
+impl_libm_float!(f32, acosf, atan2f, cbrtf, cosf, hypotf, logf, log2f, powf, sinf, sincosf, tanf);
+impl_libm_float!(f64, acos, atan2, cbrt, cos, hypot, log, log2, pow, sin, sincos, tan);
+
