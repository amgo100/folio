// The exam component's default stylesheet (SPEC §3.2, §13.1): the look of
// a question paper, and of its mark scheme in the variant `markscheme`.
// Every stylesheet of a project ranks above it (SPEC §5.1).

// Questions count through the paper and parts within their question or
// part (SPEC §4.5): 1, (a), (i), (ii), (b).
question { numbering: "1"; space-before: 1.5em; space-after: 0.5em; }
part { numbering: "(a)"; space-before: 0.5em; space-after: 0.5em; }
part part { numbering: "(i)"; }

// A question's and a part's number stand beside their text.
question > grid, part > grid {
  space-before: 0pt; space-after: 0pt; border-top: none; border-bottom: none;
  row-breakable: true;
}
question > grid > cell, part > grid > cell { padding: 0pt; }
question > box { align: end; space-before: 0.5em; }

// Answers are answer space in the paper; mark codes and notes for the
// marker are left out (SPEC §6.2, §6.3).
answer { display: answer-space; space-before: 0.5em; space-after: 0.5em; }
mark { display: none; }
markscheme-note { display: none; }

// The mark scheme shows them.
@variant markscheme {
  answer { display: block; template: markscheme-box; }
  mark { display: inline; template: badge; }
  markscheme-note { display: block; font-style: italic; }
}
answer > box { border: 0.5pt solid; padding: 0.4em 0.6em; }

// The mark scheme's table (`template: markscheme-table`): a row for each
// question and part, ruled between rows.
question > stack, part > stack { space-before: 0pt; space-after: 0pt; }
question > stack > grid, part > stack > grid {
  space-before: 0pt; space-after: 0pt; border-top: none; border-bottom: 0.4pt solid;
  row-breakable: true;
}
